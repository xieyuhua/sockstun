<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:tools="http://schemas.android.com/tools">
	<application android:label="@string/app_name" android:icon="@mipmap/tunvpn"
		android:theme="@style/Theme.TunVPN"
		android:usesCleartextTraffic="true">
		<service android:name=".TProxyService" android:process=":native"
				android:permission="android.permission.BIND_VPN_SERVICE"
				android:exported="true"
				android:foregroundServiceType="specialUse">
			<intent-filter>
				<action android:name="android.net.VpnService"/>
			</intent-filter>
			<property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
				android:value="VPN service"/>
		</service>
		<service android:name=".QSTileService"
				android:label="@string/app_name"
				android:icon="@drawable/ic_tile"
				android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
				android:exported="true">
			<intent-filter>
				<action android:name="android.service.quicksettings.action.QS_TILE"/>
			</intent-filter>
		</service>
		<receiver android:enabled="true" android:name=".ServiceReceiver"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED"/>
			</intent-filter>
		</receiver>
		<activity android:name=".MainActivity" android:label="@string/app_name"
				android:excludeFromRecents="true"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
				<category android:name="android.intent.category.LEANBACK_LAUNCHER" />
			</intent-filter>
			<!-- 长按快捷设置磁贴时打开这个页面 -->
			<intent-filter>
				<action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES"/>
				<category android:name="android.intent.category.DEFAULT"/>
			</intent-filter>
		</activity>
		<activity android:name=".AppListActivity" android:label="@string/app_name"/>
		<activity android:name=".ServerListActivity" android:label="@string/section_server"
			android:exported="false" android:parentActivityName=".MainActivity"/>
		<activity android:name=".ServerEditActivity" android:label="@string/server_edit"
			android:exported="false" android:parentActivityName=".ServerListActivity"/>
		<activity android:name=".SubscribeActivity" android:label="@string/subscribe"
			android:exported="false" android:parentActivityName=".MainActivity"/>
	<activity android:name=".SubscribeConfigActivity" android:label="@string/subs_config"
			android:exported="false" android:parentActivityName=".SubscribeActivity"/>
		<activity android:name=".RulesHubActivity" android:label="@string/rules"
			android:exported="false" android:parentActivityName=".MainActivity"/>
		<activity android:name=".LogActivity" android:label="@string/log"
			android:exported="false" android:parentActivityName=".MainActivity"/>
		<activity android:name=".SettingsActivity" android:label="@string/settings"
			android:exported="false" android:parentActivityName=".MainActivity"/>
		<activity android:name=".ConfigActivity" android:label="@string/settings_config"
			android:exported="false" android:parentActivityName=".SettingsActivity"/>
		<activity android:name=".ConnectionsActivity" android:label="@string/settings_connections"
			android:exported="false" android:parentActivityName=".SettingsActivity"/>
		<activity android:name=".RecentRequestsActivity" android:label="@string/settings_recent_requests"
			android:exported="false" android:parentActivityName=".SettingsActivity"/>
		<activity android:name=".BackupActivity" android:label="@string/backup_manager_title"
			android:exported="false" android:parentActivityName=".SettingsActivity"/>
	</application>
	<uses-permission android:name="android.permission.INTERNET"/>
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
	<uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
		tools:ignore="QueryAllPackagesPermission" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
		android:minSdkVersion="34" />
</manifest>
