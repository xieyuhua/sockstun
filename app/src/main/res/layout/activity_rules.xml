<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:title="@string/rules"
		app:titleCentered="true"
		app:titleTextAppearance="@style/TextAppearance.SocksTun.Toolbar"/>
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:fillViewport="true">
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:paddingTop="8dp"
			android:paddingBottom="16dp">
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.SocksTun.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp">
					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/rules_default_proxy"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="48dp"
						android:text="@string/rules_default_proxy"
						android:textAppearance="?attr/textAppearanceBodyLarge"/>
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="4dp"
						android:text="@string/rules_hint"
						android:textAppearance="@style/TextAppearance.SocksTun.Hint"/>
					<View
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="12dp"
						android:layout_marginBottom="8dp"
						android:background="?attr/colorOutline"/>
					<LinearLayout
						android:orientation="horizontal"
						android:layout_width="match_parent"
						android:layout_height="wrap_content">
						<Spinner
							android:id="@+id/rule_type"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:entries="@array/rule_types"
							android:minHeight="48dp"/>
						<Spinner
							android:id="@+id/rule_action"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:layout_weight="1"
							android:entries="@array/rule_actions"
							android:minHeight="48dp"/>
					</LinearLayout>
					<LinearLayout
						android:orientation="horizontal"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical">
						<EditText
							android:id="@+id/rule_value"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:hint="@string/rule_value_hint"
							android:imeOptions="actionDone"
							android:importantForAutofill="no"
							android:inputType="text"
							android:maxLines="1"/>
						<com.google.android.material.button.MaterialButton
							android:id="@+id/rule_add"
							style="?attr/materialButtonOutlinedStyle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:text="@string/rule_add"
							app:cornerRadius="20dp"/>
					</LinearLayout>
					<TextView
						android:id="@+id/rules_empty"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/rule_empty"
						android:textAppearance="@style/TextAppearance.SocksTun.Hint"/>
					<LinearLayout
						android:id="@+id/rules_list"
						android:orientation="vertical"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"/>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.SocksTun.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp">
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/section_scope"
						android:textAppearance="@style/TextAppearance.SocksTun.Section"/>
					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/global"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="48dp"
						android:text="@string/global"
						android:textAppearance="?attr/textAppearanceBodyLarge"/>
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="4dp"
						android:text="@string/global_hint"
						android:textAppearance="@style/TextAppearance.SocksTun.Hint"/>
					<com.google.android.material.button.MaterialButton
						android:id="@+id/apps"
						style="?attr/materialButtonOutlinedStyle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:minHeight="52dp"
						android:text="@string/apps"
						app:cornerRadius="26dp"
						app:icon="@drawable/ic_apps"
						app:iconGravity="textStart"
						app:iconPadding="8dp"/>
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="4dp"
						android:layout_marginTop="4dp"
						android:text="@string/apps_hint"
						android:textAppearance="@style/TextAppearance.SocksTun.Hint"/>
					<View
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="12dp"
						android:layout_marginBottom="4dp"
						android:background="?attr/colorOutline"/>
					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/ipv4"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="48dp"
						android:text="@string/ipv4"
						android:textAppearance="?attr/textAppearanceBodyLarge"/>
					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/ipv6"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="48dp"
						android:text="@string/ipv6"
						android:textAppearance="?attr/textAppearanceBodyLarge"/>
					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/udp_in_tcp"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="48dp"
						android:text="@string/udp_in_tcp"
						android:textAppearance="?attr/textAppearanceBodyLarge"/>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.SocksTun.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp">
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/section_dns"
						android:textAppearance="@style/TextAppearance.SocksTun.Section"/>
					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/remote_dns"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="48dp"
						android:text="@string/remote_dns"
						android:textAppearance="?attr/textAppearanceBodyLarge"/>
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="4dp"
						android:text="@string/remote_dns_hint"
						android:textAppearance="@style/TextAppearance.SocksTun.Hint"/>
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/til_dns_ipv4"
						style="@style/Widget.SocksTun.TextInputLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:hint="@string/dns_ipv4">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/dns_ipv4"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:digits="0123456789."
							android:maxLines="1"/>
					</com.google.android.material.textfield.TextInputLayout>
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/til_dns_ipv6"
						style="@style/Widget.SocksTun.TextInputLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:hint="@string/dns_ipv6">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/dns_ipv6"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:digits="0123456789abcdef:"
							android:maxLines="1"/>
					</com.google.android.material.textfield.TextInputLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</ScrollView>
	<com.google.android.material.button.MaterialButton
		android:id="@+id/save"
		style="?attr/materialButtonOutlinedStyle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:minHeight="56dp"
		android:text="@string/save"
		android:textSize="16sp"
		app:cornerRadius="28dp"
		app:icon="@drawable/ic_save"
		app:iconGravity="textStart"
		app:iconPadding="8dp"/>
	<include layout="@layout/bottom_nav"/>
</LinearLayout>
