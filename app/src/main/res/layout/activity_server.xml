<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:title="@string/section_server"
		app:titleCentered="true"
		app:titleTextAppearance="@style/TextAppearance.SocksTun.Toolbar"/>
	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="20dp"
		android:paddingRight="20dp"
		android:paddingTop="4dp"
		android:paddingBottom="8dp"
		android:text="@string/server_list_hint"
		android:textAppearance="@style/TextAppearance.SocksTun.Hint"/>
	<ListView
		android:id="@+id/list"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:divider="@null"
		android:paddingLeft="12dp"
		android:paddingRight="12dp"/>
	<com.google.android.material.button.MaterialButton
		android:id="@+id/add"
		style="?attr/materialButtonOutlinedStyle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:minHeight="56dp"
		android:text="@string/server_add"
		android:textSize="16sp"
		app:cornerRadius="28dp"
		app:icon="@drawable/ic_add"
		app:iconGravity="textStart"
		app:iconPadding="8dp"/>
	<include layout="@layout/bottom_nav"/>
</LinearLayout>
