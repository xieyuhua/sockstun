<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:navigationIcon="?attr/homeAsUpIndicator"
		app:title="@string/section_dns"
		app:titleTextAppearance="@style/TextAppearance.SocksTun.Toolbar"/>
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:fillViewport="true">
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:paddingTop="8dp"
			android:paddingBottom="16dp">
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.Material3.CardView.Outlined"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardCornerRadius="20dp">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingTop="8dp"
					android:paddingBottom="16dp">
					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/remote_dns"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="48dp"
						android:text="@string/remote_dns"
						android:textAppearance="?attr/textAppearanceBodyLarge"/>
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="4dp"
						android:text="@string/remote_dns_hint"
						android:textAppearance="@style/TextAppearance.SocksTun.Hint"/>
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/til_dns_ipv4"
						style="@style/Widget.SocksTun.TextInputLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:hint="@string/dns_ipv4">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/dns_ipv4"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:digits="0123456789."
							android:maxLines="1"/>
					</com.google.android.material.textfield.TextInputLayout>
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/til_dns_ipv6"
						style="@style/Widget.SocksTun.TextInputLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:hint="@string/dns_ipv6">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/dns_ipv6"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:digits="0123456789abcdef:"
							android:maxLines="1"/>
					</com.google.android.material.textfield.TextInputLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</ScrollView>
	<com.google.android.material.button.MaterialButton
		android:id="@+id/save"
		style="?attr/materialButtonOutlinedStyle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:minHeight="56dp"
		android:text="@string/save"
		android:textSize="16sp"
		app:cornerRadius="28dp"
		app:icon="@drawable/ic_save"
		app:iconGravity="textStart"
		app:iconPadding="8dp"/>
</LinearLayout>
