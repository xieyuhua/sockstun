<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:title="@string/app_name"
		app:titleCentered="true"
		app:titleTextAppearance="@style/TextAppearance.TunVPN.Toolbar"/>
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:overScrollMode="never">
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:paddingTop="4dp"
			android:paddingBottom="24dp">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/status_card"
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				app:cardCornerRadius="24dp"
				app:cardBackgroundColor="?attr/colorSurfaceVariant">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:padding="24dp">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/status_dot"
						style="@style/Widget.TunVPN.Card"
						android:layout_width="72dp"
						android:layout_height="72dp"
						app:cardBackgroundColor="?attr/colorPrimary"
						app:cardCornerRadius="36dp"
						app:strokeWidth="0dp">
						<ImageView
							android:id="@+id/status_icon"
							android:layout_width="32dp"
							android:layout_height="32dp"
							android:layout_gravity="center"
							android:contentDescription="@string/app_name"
							android:src="@drawable/ic_power"
							android:tint="?attr/colorOnPrimary"/>
					</com.google.android.material.card.MaterialCardView>
					<TextView
						android:id="@+id/status_title"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="16dp"
						android:fontFamily="monospace"
						android:text="@string/status_disconnected"
						android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"/>
					<TextView
						android:id="@+id/status_subtitle"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:gravity="center"
						android:text="@string/status_disconnected_hint"
						android:textAppearance="@style/TextAppearance.TunVPN.Hint"/>
					<TextView
						android:id="@+id/status_node"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:ellipsize="end"
						android:gravity="center"
						android:maxLines="2"
						android:textAppearance="@style/TextAppearance.TunVPN.Hint"/>
					<com.google.android.material.button.MaterialButton
						android:id="@+id/control"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="20dp"
						android:fontFamily="monospace"
						android:minHeight="56dp"
						android:text="@string/control_enable"
						android:textAllCaps="true"
						android:textSize="16sp"
						app:cornerRadius="28dp"
						app:icon="@drawable/ic_power"
						app:iconGravity="textStart"
						app:iconPadding="8dp"/>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp">
					<LinearLayout
						android:orientation="horizontal"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical">
						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="@string/traffic"
							android:textAppearance="@style/TextAppearance.TunVPN.Section"/>
						<com.google.android.material.button.MaterialButton
							android:id="@+id/traffic_reset"
							style="?attr/materialButtonOutlinedStyle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:minHeight="32dp"
							android:text="@string/traffic_reset"
							android:textSize="12sp"
							app:cornerRadius="16dp"/>
					</LinearLayout>
					<TextView
						android:id="@+id/stats_realtime"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:fontFamily="monospace"
						android:textAppearance="?attr/textAppearanceBodyMedium"/>
					<TextView
						android:id="@+id/stats_session"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:fontFamily="monospace"
						android:textAppearance="?attr/textAppearanceBodyMedium"/>
					<TextView
						android:id="@+id/stats_total"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:fontFamily="monospace"
						android:textAppearance="?attr/textAppearanceBodyMedium"/>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</ScrollView>
	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="?attr/colorOutline"/>
	<com.google.android.material.bottomnavigation.BottomNavigationView
		android:id="@+id/bottom_nav"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/colorSurfaceContainer"
		app:labelVisibilityMode="labeled"
		app:menu="@menu/bottom_menu"/>
</LinearLayout>
