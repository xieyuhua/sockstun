<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:navigationIcon="?attr/homeAsUpIndicator"
		app:title="@string/settings"
		app:titleTextAppearance="@style/TextAppearance.TunVPN.Toolbar"/>
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:fillViewport="true">
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:paddingTop="8dp"
			android:paddingBottom="24dp">
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="12dp">
					<com.google.android.material.button.MaterialButton
						android:id="@+id/settings_connection"
						style="?attr/materialButtonOutlinedStyle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="52dp"
						android:text="@string/settings_connection"
						android:textSize="15sp"
						app:cornerRadius="26dp"
						app:icon="@drawable/ic_server"
						app:iconGravity="textStart"
						app:iconPadding="8dp"/>
					<com.google.android.material.button.MaterialButton
						android:id="@+id/settings_apps"
						style="?attr/materialButtonOutlinedStyle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:minHeight="52dp"
						android:text="@string/apps"
						android:textSize="15sp"
						app:cornerRadius="26dp"
						app:icon="@drawable/ic_apps"
						app:iconGravity="textStart"
						app:iconPadding="8dp"/>
					<com.google.android.material.button.MaterialButton
						android:id="@+id/settings_log"
						style="?attr/materialButtonOutlinedStyle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:minHeight="52dp"
						android:text="@string/log"
						android:textSize="15sp"
						app:cornerRadius="26dp"
						app:icon="@drawable/ic_log"
						app:iconGravity="textStart"
						app:iconPadding="8dp"/>
					<com.google.android.material.button.MaterialButton
						android:id="@+id/settings_theme"
						style="?attr/materialButtonOutlinedStyle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:minHeight="52dp"
						android:text="@string/theme"
						android:textSize="15sp"
						app:cornerRadius="26dp"
						app:icon="@drawable/ic_palette"
						app:iconGravity="textStart"
						app:iconPadding="8dp"/>
					<com.google.android.material.button.MaterialButton
						android:id="@+id/settings_version"
						style="?attr/materialButtonOutlinedStyle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:minHeight="52dp"
						android:text="@string/settings_version"
						android:textSize="15sp"
						app:cornerRadius="26dp"
						app:icon="@drawable/ic_traffic"
						app:iconGravity="textStart"
						app:iconPadding="8dp"/>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
