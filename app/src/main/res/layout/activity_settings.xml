<?xml version="1.0" encoding="utf-8"?>
<!-- 分组的设置列表。每张卡片在这里只是个空容器；
     里面的行由 SettingsActivity 用 settings_item.xml 逐个 inflate 出来。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:navigationIcon="?attr/homeAsUpIndicator"
		app:title="@string/settings"
		app:titleTextAppearance="@style/TextAppearance.TunVPN.Toolbar"/>
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:fillViewport="true">
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:paddingBottom="24dp">
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="4dp"
				android:paddingTop="14dp"
				android:paddingBottom="6dp"
				android:text="@string/settings_group_connection"
				android:textAppearance="?attr/textAppearanceTitleSmall"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"/>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:id="@+id/settings_group_connection"
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"/>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="4dp"
				android:paddingTop="14dp"
				android:paddingBottom="6dp"
				android:text="@string/settings_group_lan"
				android:textAppearance="?attr/textAppearanceTitleSmall"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"/>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:id="@+id/settings_group_lan"
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"/>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="4dp"
				android:paddingTop="14dp"
				android:paddingBottom="6dp"
				android:text="@string/settings_group_subscription"
				android:textAppearance="?attr/textAppearanceTitleSmall"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"/>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:id="@+id/settings_group_subscription"
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"/>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="4dp"
				android:paddingTop="14dp"
				android:paddingBottom="6dp"
				android:text="@string/settings_group_latency"
				android:textAppearance="?attr/textAppearanceTitleSmall"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"/>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:id="@+id/settings_group_latency"
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"/>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="4dp"
				android:paddingTop="14dp"
				android:paddingBottom="6dp"
				android:text="@string/settings_group_backup"
				android:textAppearance="?attr/textAppearanceTitleSmall"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"/>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:id="@+id/settings_group_backup"
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"/>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="4dp"
				android:paddingTop="14dp"
				android:paddingBottom="6dp"
				android:text="@string/settings_group_general"
				android:textAppearance="?attr/textAppearanceTitleSmall"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"/>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:id="@+id/settings_group_general"
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"/>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="4dp"
				android:paddingTop="14dp"
				android:paddingBottom="6dp"
				android:text="@string/settings_group_about"
				android:textAppearance="?attr/textAppearanceTitleSmall"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"/>
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:id="@+id/settings_group_about"
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"/>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
