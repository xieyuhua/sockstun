<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:navigationIcon="?attr/homeAsUpIndicator"
		app:title="@string/settings_connections"
		app:titleTextAppearance="@style/TextAppearance.TunVPN.Toolbar"/>
	<TextView
		android:id="@+id/conn_summary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="4dp"
		android:paddingBottom="8dp"
		android:textAppearance="@style/TextAppearance.TunVPN.Hint"
		android:textColor="?attr/colorOnSurfaceVariant"/>
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingLeft="12dp"
		android:paddingRight="12dp"
		android:paddingBottom="8dp">
		<EditText
			android:id="@+id/conn_search"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:hint="@string/connections_search_hint"
			android:inputType="textFilter"
			android:imeOptions="actionDone"
			android:maxLines="1"
			android:drawableStart="@android:drawable/ic_menu_search"
			android:drawablePadding="6dp"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:textColor="?attr/colorOnSurface"/>
		<com.google.android.material.button.MaterialButton
			android:id="@+id/conn_close_all"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:minHeight="36dp"
			android:text="@string/connections_close_all"
			android:textSize="13sp"/>
	</LinearLayout>
	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">
		<ListView
			android:id="@+id/conn_list"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:divider="@null"
			android:paddingBottom="16dp"/>
		<TextView
			android:id="@+id/conn_empty"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="48dp"
			android:gravity="center"
			android:text="@string/connections_empty"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:textColor="?attr/colorOnSurfaceVariant"
			android:visibility="gone"/>
	</FrameLayout>
</LinearLayout>
