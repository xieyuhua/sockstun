<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:navigationIcon="?attr/homeAsUpIndicator"
		app:title="@string/subs_config"
		app:titleTextAppearance="@style/TextAppearance.TunVPN.Toolbar"/>
	<com.google.android.material.card.MaterialCardView
		style="@style/Widget.Material3.CardView.Outlined"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		app:cardCornerRadius="20dp">
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:text="@string/server_list_hint_sub"
			android:textAppearance="?attr/textAppearanceBodySmall"
			android:textColor="?attr/colorOutline"/>
	</com.google.android.material.card.MaterialCardView>
	<TextView
		android:id="@+id/subs_empty"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:padding="24dp"
		android:text="@string/subs_empty"
		android:textAppearance="?attr/textAppearanceBodyMedium"
		android:textColor="?attr/colorOutline"/>
	<ListView
		android:id="@+id/subs_list"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:divider="@android:color/transparent"
		android:dividerHeight="8dp"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:scrollbarStyle="outsideOverlay"/>
	<com.google.android.material.button.MaterialButton
		android:id="@+id/subs_add"
		style="?attr/materialButtonOutlinedStyle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:minHeight="52dp"
		android:text="@string/subs_add"
		android:textSize="15sp"
		app:cornerRadius="26dp"
		app:icon="@drawable/ic_subscribe"
		app:iconGravity="textStart"
		app:iconPadding="8dp"/>
</LinearLayout>
