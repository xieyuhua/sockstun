<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:navigationIcon="?attr/homeAsUpIndicator"
		app:title="@string/rules"
		app:titleTextAppearance="@style/TextAppearance.TunVPN.Toolbar"/>
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:fillViewport="true">
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:paddingTop="8dp"
			android:paddingBottom="24dp">

			<!-- 1. 分流 -->
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp">
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/section_routing"
						android:textAppearance="@style/TextAppearance.TunVPN.Section"/>
					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/global"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/global"/>
					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/ipv4"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="@string/ipv4"/>
					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/ipv6"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="@string/ipv6"/>
					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/udp_in_tcp"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="@string/udp_in_tcp"/>
					<com.google.android.material.button.MaterialButton
						android:id="@+id/apps"
						style="?attr/materialButtonOutlinedStyle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:minHeight="48dp"
						android:text="@string/apps"
						android:textSize="14sp"
						app:cornerRadius="24dp"
						app:icon="@drawable/ic_apps"
						app:iconGravity="textStart"
						app:iconPadding="8dp"/>
					<TextView
						android:id="@+id/routing_scope_hint"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:textAppearance="@style/TextAppearance.TunVPN.Hint"/>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<!-- 2. DNS -->
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp">
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/section_dns"
						android:textAppearance="@style/TextAppearance.TunVPN.Section"/>
					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/remote_dns"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/remote_dns"/>
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/til_dns_ipv4"
						style="@style/Widget.TunVPN.TextInputLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:hint="@string/dns_ipv4">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/dns_ipv4"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:inputType="text"
							android:maxLines="1"/>
					</com.google.android.material.textfield.TextInputLayout>
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/til_dns_ipv6"
						style="@style/Widget.TunVPN.TextInputLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:hint="@string/dns_ipv6">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/dns_ipv6"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:inputType="text"
							android:maxLines="1"/>
					</com.google.android.material.textfield.TextInputLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<!-- 3. 路由规则 -->
			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.TunVPN.Card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp">
				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp">
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/rules"
						android:textAppearance="@style/TextAppearance.TunVPN.Section"/>
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="@string/rules_hint"
						android:textAppearance="@style/TextAppearance.TunVPN.Hint"/>
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="@string/rule_strategy_label"
						android:textAppearance="?attr/textAppearanceBodyMedium"
						android:textColor="?attr/colorOnSurface"/>
					<Spinner
						android:id="@+id/rules_strategy"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="48dp"
						android:spinnerMode="dropdown"/>
					<TextView
						android:id="@+id/rules_mode_hint"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:textAppearance="@style/TextAppearance.TunVPN.Hint"/>
					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/rules_default_proxy"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/rules_default_proxy"/>
					<LinearLayout
						android:orientation="horizontal"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp">
						<Spinner
							android:id="@+id/rule_type"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="wrap_content"
							android:minHeight="48dp"
							android:spinnerMode="dropdown"/>
						<Spinner
							android:id="@+id/rule_action"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="wrap_content"
							android:layout_marginStart="12dp"
							android:minHeight="48dp"
							android:spinnerMode="dropdown"/>
					</LinearLayout>
					<com.google.android.material.textfield.TextInputLayout
						style="@style/Widget.TunVPN.TextInputLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:hint="@string/rule_value_hint">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/rule_value"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:inputType="text"
							android:maxLines="1"/>
					</com.google.android.material.textfield.TextInputLayout>
					<com.google.android.material.button.MaterialButton
						android:id="@+id/rule_add"
						style="?attr/materialButtonOutlinedStyle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:minHeight="48dp"
						android:text="@string/rule_add"
						android:textSize="14sp"
						app:cornerRadius="24dp"/>
					<LinearLayout
						android:id="@+id/rules_list"
						android:orientation="vertical"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"/>
					<TextView
						android:id="@+id/rules_empty"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="@string/rule_empty"
						android:textAppearance="@style/TextAppearance.TunVPN.Hint"/>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
