<?xml version="1.0" encoding="utf-8"?>
<!-- One SOCKS5 server row: a circular icon, the name (with an "enabled" chip)
     and the address, then its three actions. -->
<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	style="@style/Widget.Material3.CardView.Outlined"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	app:cardCornerRadius="16dp">
	<LinearLayout
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="14dp"
		android:paddingRight="14dp"
		android:paddingTop="12dp"
		android:paddingBottom="10dp">
		<LinearLayout
			android:orientation="horizontal"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical">
			<ImageView
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:background="@drawable/bg_avatar"
				android:contentDescription="@string/section_server"
				android:padding="10dp"
				android:src="@drawable/ic_server"
				android:tint="?attr/colorPrimary"/>
			<LinearLayout
				android:orientation="vertical"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:layout_marginStart="12dp">
				<LinearLayout
					android:orientation="horizontal"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical">
					<TextView
						android:id="@+id/item_name"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:ellipsize="end"
						android:maxLines="1"
						android:textAppearance="?attr/textAppearanceTitleSmall"
						android:textStyle="bold"/>
					<TextView
						android:id="@+id/item_badge"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="6dp"
						android:background="@drawable/bg_chip"
						android:paddingLeft="6dp"
						android:paddingRight="6dp"
						android:paddingTop="1dp"
						android:paddingBottom="1dp"
						android:text="@string/server_enabled"
						android:textColor="?attr/colorOnPrimaryContainer"
						android:textSize="10sp"
						android:textStyle="bold"
						android:visibility="gone"/>
				</LinearLayout>
				<TextView
					android:id="@+id/item_detail"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="3dp"
					android:ellipsize="middle"
					android:fontFamily="monospace"
					android:maxLines="1"
					android:textAppearance="?attr/textAppearanceBodySmall"
					android:textColor="?attr/colorOnSurfaceVariant"/>
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:orientation="horizontal"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp">
			<com.google.android.material.button.MaterialButton
				android:id="@+id/item_enable"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:minHeight="38dp"
				android:text="@string/server_enable"
				android:textSize="12sp"
				app:cornerRadius="19dp"/>
			<com.google.android.material.button.MaterialButton
				android:id="@+id/item_edit"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:layout_marginStart="10dp"
				android:minHeight="38dp"
				android:text="@string/server_edit"
				android:textSize="12sp"
				app:cornerRadius="19dp"/>
			<com.google.android.material.button.MaterialButton
				android:id="@+id/item_delete"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:layout_marginStart="10dp"
				android:minHeight="38dp"
				android:text="@string/server_delete"
				android:textSize="12sp"
				app:cornerRadius="19dp"/>
		</LinearLayout>
	</LinearLayout>
</com.google.android.material.card.MaterialCardView>
