		<item name="cardCornerRadius">18dp</item>
		<item name="cardBackgroundColor">?attr/colorSurface</item>
		<item name="strokeColor">?attr/colorOutline</item>
		<item name="strokeWidth">1dp</item>
	</style>

	<style name="Widget.Tun2VPN.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
		<item name="boxCornerRadiusTopStart">12dp</item>
		<item name="boxCornerRadiusTopEnd">12dp</item>
		<item name="boxCornerRadiusBottomStart">12dp</item>
		<item name="boxCornerRadiusBottomEnd">12dp</item>
	</style>

	<style name="TextAppearance.Tun2VPN.Toolbar" parent="TextAppearance.Material3.TitleMedium">
		<item name="fontFamily">monospace</item>
		<item name="android:fontFamily">monospace</item>
		<item name="android:letterSpacing">0.12</item>
	</style>

	<style name="TextAppearance.Tun2VPN.Section" parent="TextAppearance.Material3.TitleSmall">
		<item name="android:textColor">?attr/colorPrimary</item>
		<item name="fontFamily">monospace</item>
		<item name="android:fontFamily">monospace</item>
		<item name="android:letterSpacing">0.08</item>
	</style>

	<style name="TextAppearance.Tun2VPN.Hint" parent="TextAppearance.Material3.BodySmall">
